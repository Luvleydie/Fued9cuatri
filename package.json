{
  "name": "novacart",
  "version": "1.0.0",
  "description": "E-commerce académico con Ionic, Angular, TypeScript y API SQLite propia",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "npm run build:api && node scripts/dev.mjs",
    "build:api": "tsc -p tsconfig.server.json",
    "api": "npm run build:api && node dist/server/server/index.js",
    "serve:prod": "npm run build && npm run api",
    "test:api": "npm run build:api && node --test dist/server/server/tests/*.test.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "test:e2e": "node scripts/verify-app.mjs",
    "test:persistence": "npm run build && npm run build:api && node scripts/verify-persistence.mjs",
    "video:persistence": "npm run build && npm run build:api && node scripts/verify-persistence.mjs --record && python scripts/render-persistence-video.py",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.6",
    "@angular/compiler": "22.1.6",
    "@angular/core": "22.1.6",
    "@angular/forms": "22.1.6",
    "@angular/platform-browser": "22.1.6",
    "@angular/platform-browser-dynamic": "22.1.6",
    "@angular/router": "22.1.6",
    "@capacitor/core": "8.4.3",
    "@ionic/angular": "^9.0.0",
    "axios": "^1.20.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.6",
    "@angular/language-service": "22.1.6",
    "@capacitor/cli": "8.4.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.2",
    "angular-eslint": "22.0.0",
    "eslint": "^9.16.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.19.1"
  }
}
